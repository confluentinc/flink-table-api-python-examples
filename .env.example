CONFLUENT_CLOUD_REGION=us-east-1
CONFLUENT_ORG_ID=00000000-0000-0000-0000-000000000000
CONFLUENT_ENV_ID=env-xxxxx
CONFLUENT_COMPUTE_POOL_ID=lfcp-xxxxxxxxxx
CONFLUENT_FLINK_API_KEY=XXXXXXXXXXXXXXXX
CONFLUENT_FLINK_API_SECRET=XxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXx
